{
  "name": "techstore-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @techstore/web",
    "build:web": "npm run build --workspace @techstore/web",
    "start:web": "npm run start --workspace @techstore/web",
    "typecheck:web": "npm run typecheck --workspace @techstore/web",
    "dev:api": "mvn -f apps/api/pom.xml spring-boot:run",
    "test:api": "mvn -f apps/api/pom.xml test"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
