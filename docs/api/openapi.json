{
  "openapi": "3.0.3",
  "info": {
    "title": "TechStore API - contrato inicial",
    "version": "0.1.0",
    "description": "Contrato frontend/backend. Implementados: salud, catálogo, registro, autenticación y carrito persistente protegido. Pedidos/checkout siguen planificados. Bearer opaco revocable, NO JWT; pagos exclusivamente simulados."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Spring Boot local; no es endpoint de producción"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Diagnóstico existente"
    },
    {
      "name": "Catalog",
      "description": "Catálogo público planificado"
    },
    {
      "name": "Auth",
      "description": "Autenticación de clientes planificada"
    },
    {
      "name": "Orders",
      "description": "Pedidos persistentes planificados"
    },
    {
      "name": "Admin",
      "description": "Comprobación mínima de acceso administrativo; panel de administración pendiente"
    },
    {
      "name": "Cart",
      "description": "Carrito persistente del cliente autenticado; no reserva stock ni confirma precios"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "operationId": "getHealth",
        "summary": "Consultar salud básica del servicio",
        "responses": {
          "200": {
            "description": "Servicio en ejecución",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        },
        "x-implementation-status": "implemented"
      }
    },
    "/api/products": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "operationId": "listProducts",
        "summary": "Listar productos activos",
        "responses": {
          "200": {
            "description": "Página de productos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductPage"
                }
              }
            }
          },
          "400": {
            "description": "Solicitud inválida o datos con formato incorrecto",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Error inesperado del servidor",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "description": "Paginación desde 0"
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 12
            },
            "description": "Cantidad de registros por página"
          }
        ],
        "x-implementation-status": "implemented"
      }
    },
