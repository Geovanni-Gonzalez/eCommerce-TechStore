          "409": {
            "description": "Conflicto con el estado actual",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Regla de negocio no satisfecha",
