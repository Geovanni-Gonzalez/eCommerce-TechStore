        "responses": {
          "204": {
            "description": "Eliminación idempotente; sin contenido"
          },
          "400": {
            "description": "Identificador inválido",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Token Bearer requerido o inválido",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "La cuenta no tiene rol CLIENT",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-implementation-status": "implemented"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Opaque",
        "description": "Token opaco aleatorio Bearer de 256 bits, duración de 8 horas y revocación en PostgreSQL; NO es un JWT. Usar HTTPS fuera del desarrollo local."
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "description": "Salud declarada por el endpoint",
            "enum": [
              "UP"
            ]
          },
          "service": {
            "type": "string",
            "description": "Nombre del servicio",
            "example": "techstore-api"
          }
        },
        "required": [
          "status",
          "service"
        ]
      },
      "Category": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "Identificador interno"
          },
          "name": {
            "type": "string",
            "description": "Nombre visible de categoría",
            "example": "Accesorios"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "Product": {
        "type": "object",
        "description": "Producto activo; la categoría y la imagen son opcionales.",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "Identificador interno"
          },
          "sku": {
            "type": "string",
            "description": "Código único de producto",
            "example": "TEC-001"
          },
          "name": {
            "type": "string",
            "description": "Nombre comercial",
            "example": "Mouse inalámbrico"
          },
          "description": {
            "type": "string",
            "description": "Descripción del producto",
            "example": "Mouse ergonómico inalámbrico"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "priceCrc": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "description": "Precio de catálogo en colones costarricenses (CRC)",
            "example": 12990
          },
          "stock": {
            "type": "integer",
            "minimum": 0,
            "description": "Cantidad disponible en inventario",
            "example": 15
          },
          "imageUrl": {
            "type": "string",
            "description": "Imagen pública del producto; puede faltar en prototipo",
            "format": "uri"
          },
          "active": {
            "type": "boolean",
            "description": "El catálogo público solo devuelve productos activos"
          }
        },
        "required": [
          "id",
          "sku",
          "name",
          "priceCrc",
          "stock",
          "active"
        ]
      },
      "ProductPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 0,
            "description": "Número de página desde 0"
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "totalElements": {
            "type": "integer",
            "minimum": 0
          },
          "totalPages": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "items",
          "page",
          "size",
          "totalElements",
          "totalPages"
        ]
      },
      "RegisterRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "displayName": {
            "type": "string",
            "description": "Nombre visible",
            "minLength": 2,
            "maxLength": 120,
            "example": "Ana Pérez"
          },
          "email": {
            "type": "string",
            "description": "Correo único de la cuenta",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "description": "Contraseña; nunca almacenar ni retornar en texto plano. BCrypt acepta máximo 72 bytes UTF-8 para evitar truncamientos silenciosos.",
            "format": "password",
            "minLength": 8,
            "maxLength": 128,
            "x-max-utf8-bytes": 72
          }
        },
        "required": [
          "displayName",
          "email",
          "password"
        ]
      },
      "User": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "Identificador interno"
          },
          "displayName": {
            "type": "string",
            "description": "Nombre público de usuario"
          },
          "email": {
            "type": "string",
            "description": "Correo de la cuenta",
            "format": "email"
          },
          "role": {
            "type": "string",
            "description": "Rol de acceso",
            "enum": [
              "CLIENT",
              "ADMIN"
            ]
          }
        },
        "required": [
          "id",
          "displayName",
          "email",
          "role"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "description": "Correo de cuenta",
            "format": "email"
          },
          "password": {
            "type": "string",
            "description": "Contraseña",
            "format": "password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthSession": {
        "type": "object",
        "description": "Respuesta de autenticación Bearer opaca, revocable en logout.",
        "additionalProperties": false,
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Token Bearer opaco temporal; no se almacena ni imprime en logs; mantenerlo fuera de localStorage."
          },
          "tokenType": {
            "type": "string",
            "description": "Tipo de autorización",
            "enum": [
              "Bearer"
            ]
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "required": [
          "accessToken",
          "tokenType",
          "user"
        ]
      },
      "ShippingAddress": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "province": {
            "type": "string",
            "description": "Provincia de Costa Rica",
            "minLength": 1,
            "maxLength": 80
          },
          "canton": {
            "type": "string",
            "description": "Cantón",
            "minLength": 1,
            "maxLength": 80
          },
          "district": {
            "type": "string",
            "description": "Distrito",
            "minLength": 1,
            "maxLength": 80
          },
          "details": {
            "type": "string",
            "description": "Señas y referencias",
            "minLength": 5,
            "maxLength": 300
          },
          "recipientName": {
            "type": "string",
            "description": "Nombre de la persona que recibe",
            "minLength": 2,
            "maxLength": 120
          },
          "phone": {
            "type": "string",
            "description": "Número de contacto",
            "minLength": 8,
            "maxLength": 24
          }
        },
        "required": [
          "province",
          "canton",
          "district",
          "details",
          "recipientName",
          "phone"
        ]
      },
      "OrderLineRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "productId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "Identificador del producto"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          }
        },
        "required": [
          "productId",
          "quantity"
        ]
      },
      "CreateOrderRequest": {
        "type": "object",
        "description": "Pedido para simulación; jamás incluir información de tarjeta.",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/OrderLineRequest"
            }
          },
          "shippingAddress": {
            "$ref": "#/components/schemas/ShippingAddress"
          }
        },
        "required": [
          "items",
          "shippingAddress"
        ]
      },
      "OrderItem": {
        "type": "object",
        "description": "Snapshot comercial; no depende de cambios futuros del catálogo.",
        "additionalProperties": false,
        "properties": {
          "productId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "Identificador interno"
          },
          "name": {
            "type": "string",
            "description": "Nombre histórico de producto en pedido"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "unitPriceCrc": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "description": "Precio unitario capturado al confirmar pedido"
          },
          "lineTotalCrc": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "description": "Precio total de línea"
          }
        },
        "required": [
          "productId",
          "name",
          "quantity",
          "unitPriceCrc",
          "lineTotalCrc"
        ]
      },
      "OrderTotals": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "subtotalCrc": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "description": "Subtotal de artículos"
          },
          "shippingCrc": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "description": "Costo de envío (Strategy)"
          },
          "taxCrc": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "description": "Impuestos calculados en backend"
          },
          "totalCrc": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "description": "Monto final en CRC"
          }
        },
        "required": [
          "subtotalCrc",
          "shippingCrc",
          "taxCrc",
          "totalCrc"
        ]
      },
      "Order": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "Identificador interno"
          },
          "status": {
            "type": "string",
            "description": "Estado actual del pedido",
            "enum": [
              "PENDING",
              "CONFIRMED",
              "CANCELLED"
            ]
          },
          "paymentMode": {
            "type": "string",
            "description": "Solo demostración; no procesa tarjetas",
            "enum": [
              "SIMULATED"
            ]
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            }
          },
          "shippingAddress": {
            "$ref": "#/components/schemas/ShippingAddress"
          },
          "totals": {
            "$ref": "#/components/schemas/OrderTotals"
          },
          "createdAt": {
            "type": "string",
            "description": "Instante de creación",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "status",
          "paymentMode",
          "items",
          "shippingAddress",
          "totals",
          "createdAt"
        ]
      },
      "OrderPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Order"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "totalElements": {
            "type": "integer",
            "minimum": 0
          },
          "totalPages": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "items",
          "page",
          "size",
          "totalElements",
          "totalPages"
        ]
      },
      "FieldError": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string",
            "description": "Campo de la solicitud"
          },
          "message": {
            "type": "string",
            "description": "Explicación de validación"
          }
        },
        "required": [
          "field",
          "message"
        ]
      },
      "Problem": {
        "type": "object",
        "description": "Error conforme a Problem Details (application/problem+json).",
        "additionalProperties": true,
        "properties": {
          "type": {
            "type": "string",
            "description": "URI que identifica el tipo de error",
            "format": "uri-reference",
            "example": "about:blank"
          },
          "title": {
            "type": "string",
            "description": "Título legible del error"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599,
            "description": "Estado HTTP devuelto"
          },
          "detail": {
            "type": "string",
            "description": "Descripción segura del error"
          },
          "instance": {
            "type": "string",
            "description": "Ruta asociada al error"
          },
          "code": {
            "type": "string",
            "description": "Código interno estable (por ejemplo VALIDATION_ERROR)",
            "example": "VALIDATION_ERROR"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "description": "Errores de campos cuando aplica"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ]
      },
      "AdminAccess": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "AUTHORIZED"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN"
            ]
          }
        },
        "required": [
          "status",
          "role"
        ]
      },
      "CartItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "productId",
          "sku",
          "name",
          "quantity",
          "stock",
          "available",
          "unitPriceCrc",
          "lineSubtotalCrc"
        ],
        "properties": {
          "productId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          },
          "stock": {
            "type": "integer",
            "minimum": 0
          },
          "available": {
            "type": "boolean",
            "description": "Verdadero solo si el producto sigue activo y tiene stock suficiente"
          },
          "unitPriceCrc": {
            "type": "number",
            "minimum": 0,
            "description": "Precio vigente de catálogo en CRC"
          },
          "lineSubtotalCrc": {
            "type": "number",
            "minimum": 0,
            "description": "Precio vigente multiplicado por cantidad; CRC"
          }
        }
      },
      "Cart": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "totalItems",
          "subtotalCrc",
          "checkoutReady"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CartItem"
            }
          },
          "totalItems": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "subtotalCrc": {
            "type": "number",
            "minimum": 0,
            "description": "Subtotal estimado de todos los artículos, incluso no disponibles. Sin impuestos/envío. Checkout debe recalcular y validar stock/precio."
          },
          "checkoutReady": {
            "type": "boolean",
            "description": "Todos los artículos siguen activos y cuentan con stock suficiente; false en carrito vacío"
          }
        }
      },
      "AddCartItemRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "productId",
          "quantity"
        ],
        "properties": {
          "productId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          }
        }
      },
      "UpdateCartQuantityRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "quantity"
        ],
        "properties": {
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          }
        }
      }
    }
  }
}
