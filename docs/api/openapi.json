            },
            "headers": {
              "Location": {
                "description": "URI del pedido creado",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Solicitud inválida o datos con formato incorrecto",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
